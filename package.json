{
  "name": "streifzug",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @streifzug/web",
    "build": "npm run build -w @streifzug/web",
    "typecheck": "tsc -p packages/core && tsc -p apps/web && tsc -p scripts",
    "strassen:koeln": "NODE_USE_ENV_PROXY=1 tsx scripts/strassen-koeln.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "@types/node": "^24.0.0",
    "mapshaper": "^0.8.5",
    "pbf": "^5.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=22"
  }
}
